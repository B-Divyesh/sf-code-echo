{
  "name": "code-echo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first, code-aware reading aid for the browser.",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config site/vite.config.ts",
    "clean": "node scripts/clean.mjs",
    "build:extension": "wxt build && wxt zip",
    "build:site": "npm run build:extension && vite build --config site/vite.config.ts && node scripts/stage-extension.mjs",
    "build": "npm run clean && npm run build:site",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.1.1",
    "@types/node": "^22.10.2",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  }
}
